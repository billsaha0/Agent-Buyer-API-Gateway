# For local testing, use http://localhost:3000. Update this to your Vercel URL in production.
BASE_URL="http://localhost:3000"

# Connection string for your PostgreSQL database (must support pgvector)
DATABASE_URL="postgres://user:password@host:port/defaultdb?sslmode=require"


# Razorpay Credentials
RAZORPAY_KEY_ID="your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Your Google Gemini API Key for generating pgvector embeddings and agent reasoning
GEMINI_API_KEY="your_gemini_key_here"

# Used by external agents to authenticate and get session tokens (masterSecret)
AGENT_GATEWAY_SECRET="super_secure_internal_gateway_secret"

# Used by you (human admin) to push new inventory via the admin routes
ADMIN_SECRET="super_secure_admin_secret"